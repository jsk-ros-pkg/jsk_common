<?xml version="1.0"?>
<package format="3">
  <name>jsk_common</name>
  <version>3.0.0</version>
  <description>
   <p>Metapackage that contains commonly used toolset for jsk-ros-pkg</p>
  </description>

  <maintainer email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</maintainer>
  <author email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</author>

  <license>BSD</license>
  <url type="website">http://ros.org/wiki/jsk_common</url>
  <url type="repository">https://github.com/jsk-ros-pkg/jsk_common</url>
  <url type="bugtracker">https://github.com/jsk-ros-pkg/jsk_common/issues</url>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <!-- released for both ROS1 and ROS2, so no condition -->
  <exec_depend>audio_video_recorder</exec_depend>
  <exec_depend>dynamic_tf_publisher</exec_depend>
  <exec_depend>image_view2</exec_depend>
  <exec_depend>jsk_rosbag_tools</exec_depend>
  <exec_depend>jsk_topic_tools</exec_depend>
  <exec_depend>jsk_tools</exec_depend>

  <!-- not yet ported to ROS2 -->
  <exec_depend condition="$ROS_VERSION == 1">multi_map_server</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">virtual_force_publisher</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">jsk_network_tools</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">jsk_tilt_laser</exec_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
