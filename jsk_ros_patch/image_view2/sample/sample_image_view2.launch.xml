<!-- ROS 2 sample of image_view2:
     ros2 launch image_view2 sample_image_view2.launch.xml
     shows sample/kiva_pod_image_color.jpg with ImageMarker2s drawn on it in
     a window, and publishes the drawn image on /camera/image/marked. -->
<launch>
  <arg name="gui" default="true"
       description="Show the image in a window (use_window of image_view2)" />
  <arg name="file_name"
       default="$(find-pkg-share image_view2)/sample/kiva_pod_image_color.jpg"
       description="Image file to publish" />
  <arg name="interaction_mode" default="rectangle"
       description="rectangle, line, poly, grabcut, grabcut_rect, ..." />

  <!-- publishes image, camera_info and image_marker -->
  <node name="publish_sample_image"
        pkg="image_view2" exec="publish_sample_image.py">
    <remap from="image" to="camera/image" />
    <remap from="camera_info" to="camera/camera_info" />
    <param name="file_name" value="$(var file_name)" />
  </node>

  <!-- subscribes image_marker -->
  <node name="image_view2"
        pkg="image_view2" exec="image_view2" output="screen">
    <remap from="image" to="camera/image" />
    <remap from="camera_info" to="camera/camera_info" />
    <param name="use_window" value="$(var gui)" />
    <!-- the window of the size of the image -->
    <param name="autosize" value="true" />
    <param name="interaction_mode" value="$(var interaction_mode)" />
  </node>
</launch>
